#!/usr/bin/env bash
set -euo pipefail

JAR_PATH="target/database-migration-platform-0.0.1-SNAPSHOT.jar"

export LEXTR_POSTGRES_PASSWORD="${LEXTR_POSTGRES_PASSWORD:-Mygooru1028$}"
export LEXTR_CLICKHOUSE_PASSWORD="${LEXTR_CLICKHOUSE_PASSWORD:-}"

run_with_maven() {
  joined=""
  for arg in "$@"; do
    joined+="${arg} "
  done
  sh mvnw -q spring-boot:run "-Dspring-boot.run.arguments=${joined% }"
}

if [[ -f "${JAR_PATH}" ]] && unzip -p "${JAR_PATH}" META-INF/MANIFEST.MF 2>/dev/null | grep -q "Main-Class: org.springframework.boot.loader.launch.JarLauncher"; then
  java -jar "${JAR_PATH}" "$@"
else
  run_with_maven "$@"
fi
