#!/usr/bin/env bash
set -euo pipefail

if [[ -f target/migration-platform-0.0.1-SNAPSHOT.jar ]]; then
  java -jar target/migration-platform-0.0.1-SNAPSHOT.jar "$@"
else
  joined=""
  for arg in "$@"; do
    joined+="${arg} "
  done
  sh mvnw -q spring-boot:run "-Dspring-boot.run.arguments=${joined% }"
fi
